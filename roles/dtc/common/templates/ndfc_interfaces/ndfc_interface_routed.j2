{% from 'macros/translate_setting.j2' import translate %}
---
# This NDFC routed interface data structure is auto-generated
# DO NOT EDIT MANUALLY
#

{% for switch in data_model_extended.vxlan.topology.switches %}
{% if switch.interfaces is defined %}
{% for interface in switch['interfaces'] %}
{% if interface['mode'] == 'routed' %}
- name: {{ interface['name'] }}
  type: eth
  switch:
{% if switch.management.management_ipv4_address is defined %}
    - {{ switch.management.management_ipv4_address}}
{% elif (switch.management.management_ipv4_address is not defined) and (switch.management.management_ipv6_address is defined)  %}
    - {{ switch.management.management_ipv6_address}}
{% endif %}
  deploy: false
  profile:
    admin_state: {{ interface['enabled'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_routed_interface.enabled) | lower }}
    mode: 'routed'
{% if interface['ipv4_address'] is defined %}
{% set ipv4_address__mask = interface['ipv4_address'].split('/') %}
    ipv4_addr: {{ ipv4_address__mask[0] | default(omit) }}
    ipv4_mask_len: {{ ipv4_address__mask[1] | default(omit) }}
{% endif %}
{% if interface['ipv6_address'] is defined %}
{% set ipv6_address__mask = interface['ipv6_address'].split('/') %}
    ipv6_addr: {{ ipv6_address__mask[0] | default(omit) }}
    ipv6_mask_len: {{ ipv6_address__mask[1] | default(omit) }}
{% endif %}
    description: "{{ interface['description'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_routed_interface.description) }}"
    route_tag: {{ interface['ipv4_route_tag'] | default(omit) }}
    int_vrf: {{ interface['vrf'] | default(omit) }}
    mtu: {{ interface['mtu'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_routed_interface.mtu) }}
    speed: {{ interface['speed'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_routed_interface.speed) }}
    enable_qos: {{ interface['enable_qos'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_routed_interface.enable_qos) | lower }}
{% if interface['enable_qos'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_routed_interface.enable_qos) %}
    qos_policy: {{ interface['qos_policy'] | default("") }}
{% endif %}
{% if interface['queuing_policy'] is defined %}
    queuing_policy: {{ interface['queuing_policy'] | default("") }}
{% endif %}
{% if ndfc_version | cisco.nac_dc_vxlan.version_compare('12.4.1', '>=') %}
    fec: "{{ interface['fec'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_routed_interface.fec) }}"
{% endif %}
{% if ndfc_version | cisco.nac_dc_vxlan.version_compare('12.6.0', '>') %}
{# Data model defines ENABLE LLDP TRANSMIT/RECEIVE, while base collection defines DISABLE LLDP TRANSMIT/RECEIVE #}
    disable_lldp_transmit: {{ translate(interface['enable_lldp_transmit'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_routed_interface.enable_lldp_transmit), {true: 'false', false: 'true'}) }}
    disable_lldp_receive: {{ translate(interface['enable_lldp_receive'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_routed_interface.enable_lldp_receive), {true: 'false', false: 'true'}) }}
{% if interface['enable_qos'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_access_interface.enable_qos) %}
{# Data model defines value as ENABLE QOS STATS, while base collection defines it as DISABLE QOS STATS #}
    disable_qos_stats: {{ translate(interface['enable_qos_stats'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_routed_interface.enable_qos_stats), {true: 'false', false: 'true'}) }}
{% endif %}
{% if interface['queuing_policy'] is defined %}
{# Data model defines value as ENABLE QUEUING STATS, while base collection defines it as DISABLE QUEUING STATS #}
    disable_queuing_stats: {{ translate(interface['enable_queuing_stats'] | default(defaults.vxlan.topology.switches.interfaces.topology_switch_routed_interface.enable_queuing_stats), {true: 'false', false: 'true'}) }}
{% endif %}
{% endif %}
    cmds: |2-
      {{ interface['freeform_config'] | default('') | indent(6, false) }}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
